@model Maintenance.TraceSp.Models.TracingSp
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link href="~/themes/shared/contextmenu.less" rel="stylesheet" type="text/css" />
    <link href="~/themes/shared/formedit.less" rel="stylesheet" type="text/css" />
    <link href="~/tracingsp/style.css" rel="stylesheet" />
}
@section Headline {
    <h1>
        Database Profiler
    </h1>
}

<section id="filter-bar">
    <div class="filter-form">        
        <div class="filter-row">
            <div class="lbl-field width-80">
                @Html.LabelFor(m => m.Server, "Server")
            </div>
            <div class="edit-field width-180">
                @Html.DropDownListFor(m => m.Server, new SelectList(Model.Servers, "Ip", "Name"), new { @class = "width-180" })
            </div>
            <div class="lbl-field width-80">
                @Html.LabelFor(m => m.Site, "Site")
            </div>
            <div class="edit-field width-180">
                @Html.DropDownListFor(m => m.Site, new SelectList(Model.Sites, "Id", "Name"), new { @class = "width-180" })
            </div>
            <div class="lbl-field width-80">
                @Html.LabelFor(m => m.TraceTimer, "Trace Timer")
            </div>
            <div class="edit-field width-80">
                @Html.TextBoxFor(m => m.TraceTimer, new { @Value = "30", @class = "width-60" })
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.TraceStartEvents, "Include Starting Events")
            </div>
            <div class="edit-field width-60">
                @Html.CheckBoxFor(m => m.TraceStartEvents, new { @Value = "60", @class = "width-60" })
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field width-80">
                @Html.LabelFor(m => m.TextDataLike, "Text Like")
            </div>
            <div class="edit-field width-180">
                @Html.TextBoxFor(m => m.TextDataLike, new { @class = "width-180" })
            </div>
            <div class="lbl-field width-80">
                @Html.LabelFor(m => m.TextDataLike2, "Text Like 2")
            </div>
            <div class="edit-field width-180">
                @Html.TextBoxFor(m => m.TextDataLike2, new { @class = "width-180" })
            </div>
            <div class="lbl-field width-80">
                @Html.LabelFor(m => m.TextDataLike3, "Text Like 3")
            </div>
            <div class="edit-field width-180">
                @Html.TextBoxFor(m => m.TextDataLike3, new { @class = "width-180" })
            </div>
            <div class="submit margin-left">
                <input id="button-search" type="submit" value="Submit" />
            </div>
        </div>
    </div>
</section>
<section id="body">
    <div id="tracingsp-container">
        <div id="tracingsp-report" class="freegrid display-none">
        </div>
    </div>
</section>
<div id="errorDialog" title="Message Info">    
</div>
@section Foot {
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
    <script src="~/tracingsp/tracingspcontroller.js"></script>
    <script src="~/scripts/lib/contextmenu/contextmenucontroller.js" type="text/javascript"></script>
}
