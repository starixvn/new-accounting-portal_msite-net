@model HttpGetLogParams
@{
    ViewBag.Title = "Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link href="~/themes/shared/contextmenu.less" rel="stylesheet" type="text/css" />
    <link href="~/themes/manage/letstalkreport.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        Mattermost Report
    </h1>
}
<section id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.FromDate, "From")
            </div>
            <div class="edit-field">
                @Html.TextBox("FromDate", DateTimeOffset.Now.ToString("MMM dd,yyyy"), "", new { style = "width: 100px" })
            </div>
            <div class="lbl-field width-120">
                @Html.LabelFor(m => m.ToDate, "To")
            </div>
            <div class="edit-field">
                @Html.TextBox("ToDate", DateTimeOffset.Now.ToString("MMM dd,yyyy"), "", new { style = "width: 100px" })
            </div>            
        </div>
        <div class="filter-row">
            <div class="lbl-field width-100">
                Target Name
            </div>
            <div class="edit-field">
                <select id="Target" class="select2-choice width-140">
                    <option>All</option>
                </select>
            </div>
            <div class="lbl-field width-120">
                Group
            </div>
	        <div class="edit-field width-130">
		        <select id="Group" class="select2-choice width-140">
			        <option>All</option>
		        </select>
	        </div>
	        <div class="lbl-field width-120">
		        Status
	        </div>
	        <div class="edit-field width-130">
		        <select id="Status" class="select2-choice width-140">
			        <option value="2">All</option>
                    <option value="0">FAILED</option>
                    <option value="1">SUCCEEDED</option>
		        </select>
	        </div>
            <div class="submit">
                <input id="button-search" type="submit" value="Submit" />
            </div>
        </div>
    </div>
</section>
<section id="body">
    <div id="mattermost-report-container" class="mattermost-report-container">
		<div class="btnResend display-none">
			<input type="submit" value="Resend" id="btnResendMulti" />
		</div>
        <div id="mattermost-report" class="freegrid display-none">
		</div>
	</div>
	@Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
</section>
@section Foot {
    
    <script src="~/scripts/lib/contextmenu/contextmenucontroller.js" type="text/javascript"></script>
    <script src="~/scripts/lib/custom-datepicker.js" type="text/javascript"></script>
    <script src="~/scripts/lib/popup/dialogbox.js" type="text/javascript"></script>
    <script src="~/mattermost/mattermostreportcontroller.js?v=1" type="text/javascript"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~/")';
    </script>
}
