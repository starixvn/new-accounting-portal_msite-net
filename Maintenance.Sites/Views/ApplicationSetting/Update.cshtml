@model Maintenance.BotService.Models.App.ApplicationSetting

@{
    ViewBag.Title = "Update";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link href="~/themes/manage/bot-service/bot-service.less" rel="stylesheet" type="text/css" />
    <link href="~/themes/shared/contextmenu.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title">
            <span class="first">Bot Service / </span><span class="second">
                Manage Application Setting /
            </span>
            @ViewBag.Title
        </span>
        <div class="button-action">
            <a id="btnBackToList" class="lnk" href="~/ApplicationSetting/Index">
                ← Back to list
            </a>
        </div>
    </h1>
}

<section id="filter-bar" class="manage-letstalk-message">
    <div class="form">
        <div id="validation-summary-row" class="form-row display-none">
            <div class="lbl-field width-180">
            </div>
            <div class="edit-field">
                <div id="validationSummary" style="width: 100%;"></div>
            </div>
        </div>
        <input type="text" hidden id="AppId" value="@Model.AppId" readonly />
        <div class="form-row">
            <div class="lbl-field width-180">
                <b>Application Name</b>
            </div>
            <div class="edit-field ddl-group">
                <input type="text" maxlength="100" style="width: 397px;" id="ApplicationName" value="@Model.AppName" /><br />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-180">
                <b>Microsoft App Id</b>
            </div>
            <div class="edit-field">
                <input type="text" maxlength="200" style="width: 397px;" id="MicrosoftAppId" value="@Model.MicrosoftAppId" readonly disabled /><br />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-180">
                <b>Microsoft App Password</b>
            </div>
            <div class="edit-field">
                <input type="password" maxlength="200" style="width: 397px;" id="MicrosoftAppPassword" value="@Model.MicrosoftAppPassword" />
                <span class="show-pwd">Show</span>
                <br />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-180">
                <b>Description</b>
            </div>
            <div class="edit-field lt-content">
                <textarea id="Description" maxlength="1024" style="width: 402px; height: 152px;">@Model.Description</textarea><br />
                <span class="red-color">Max Length: 1024 characters</span>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-180">
                <b>Active</b>
            </div>
           
            <div class="edit-field ddl-group">
                <input type="checkbox" id="Active" value="@Model.IsActive" @(Model.IsActive ? "checked" : string.Empty) /><br />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-180">
                <b>Hidden content on Message List</b>
            </div>

            <div class="edit-field ddl-group">
                <input type="checkbox" id="HiddenContent" value="@Model.IsHideContent" @(Model.IsHideContent ? "checked" : string.Empty) /><br />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-180"></div>
            <div class="edit-field">
                <input id="btnUpdate" type="submit" value="Update" class="mr-5" />
            </div>
            <div class="edit-field">
                <input id="btnCancel" type="submit" value="Cancel" />
            </div>
        </div>
    </div>
</section>

@section Foot {
    <script src="~/scripts/lib/fanex.multiselect/fanex.multiselect.js" type="text/javascript"></script>
    <script src="~/scripts/lib/contextmenu/contextmenucontroller.js" type="text/javascript"></script>
    <script src="~/bot-service/edit.js" type="text/javascript"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
}