@{
    ViewBag.Title = "Create Application Setting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link href="~/themes/manage/bot-service/bot-service.less" rel="stylesheet" type="text/css" />
    <link href="~/themes/shared/contextmenu.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title"><span class="black-text">Bot Service </span> / Manage Application Setting / Create</span>
        @Html.ActionLink("← Back To List", "Index", "ApplicationSetting", new { @class = "lnk" })
    </h1>
}

<section id="filter-bar" class="manage-letstalk-message">
    <div class="form">
        <div id="validation-summary-row" class="form-row display-none">
            <div class="lbl-field width-180">
            </div>
            <div class="edit-field">
                <div id="validationSummary" style="width: 100%;"></div>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-180">
                <b>Application Name</b>
            </div>
            <div class="edit-field ddl-group">
                <input type="text" maxlength="100" style="width: 397px;" id="ApplicationName" value="" /><br />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-180">
                <b>Microsoft App Id</b>
            </div>
            <div class="edit-field">
                <input type="text" maxlength="200" style="width: 397px;" id="MicrosoftAppId" value="" /><br />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-180">
                <b>Microsoft App Password</b>
            </div>
            <div class="edit-field">
                <input type="password" maxlength="200" style="width: 397px;" id="MicrosoftAppPassword" value="" /><br />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-180">
                <b>Description</b>
            </div>
            <div class="edit-field lt-content">
                <textarea id="Description" maxlength="1024" style="width: 402px; height: 152px;"></textarea><br />
                <span class="red-color">Max Length: 1024 characters</span>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-180"></div>
            <div class="edit-field">
                <input id="btnCreate" type="submit" value="Create" class="mr-5" />
            </div>
            <div class="edit-field">
                <input id="btnCancel" type="submit" value="Cancel" />
            </div>
        </div>
     </div>
</section>

@section Foot {
    <script src="~/scripts/lib/fanex.multiselect/fanex.multiselect.js" type="text/javascript"></script>
    <script src="~/scripts/lib/contextmenu/contextmenucontroller.js" type="text/javascript"></script>
    <script src="~/bot-service/create.js" type="text/javascript"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
}