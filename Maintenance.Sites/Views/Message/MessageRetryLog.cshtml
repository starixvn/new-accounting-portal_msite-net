@using Newtonsoft.Json;
@using Maintenance.BotService.Models.Message;
@model List<MessageRetryLog>
@{
    ViewBag.Title = "";
    var logs = JsonConvert.SerializeObject(Model);
}
<!DOCTYPE html>
<html lang="en" class="linen">
<head>
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="/css/common.css" type="text/css" />
    <link rel="stylesheet" href="/css/common-less.css" type="text/css" />
    <link href="/themes/manage/bot-service/bot-service.less" rel="stylesheet" />
</head>
<body id="body">
    <div id="message retry-log-container" class="message-log-container">
        <div id="message-retry-log" class="freegrid display-none">
        </div>
    </div>
    <script type="text/ecmascript" src="/scripts/sharedscripts.js"></script>
    <script src="~/message/messageRetryLog.js"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~/")';
        var messageRetryLog = @Html.Raw(logs);
    </script>
</body>
</html>
