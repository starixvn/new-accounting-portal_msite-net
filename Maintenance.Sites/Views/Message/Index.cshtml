@model GetMessageParams
@{
    ViewBag.Title = "Message Manage";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hasHostManageMessage = ViewBag.HasHostManageMessage;
}
@section Head {
    <link href="~/themes/shared/contextmenu.less" rel="stylesheet" type="text/css" />
    <link href="~/themes/manage/bot-service/bot-service.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title"><span class="black-text">Bot Service </span> / Manage Message</span>
    </h1>
}

<section id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field width-80">App Name</div>
            <div class="edit-field width-120">
                <select id="AppId" class="select2-choice width-120">
                    <option value="">All</option>
                    @foreach (var item in ViewBag.AppList)
                    {
                        <option value="@item.AppId">@item.AppName</option>
                    }
                </select>
            </div>
          
            <div class="lbl-field width-60">Channel</div>
            <div class="edit-field width-120">
                <select id="Channel" class="select2-choice width-120">
                    <option value="">All</option>
                    @foreach (var item in ViewBag.ChannelList)
                    {
                        <option value="@item.ChannelId">@item.ChannelName</option>
                    }
                </select>
            </div>

            <div class="lbl-field width-40">Bot</div>
            <div class="edit-field width-120">
                <select id="Bot" class="select2-choice width-120">
                    <option value="">All</option>
                    @foreach (var item in ViewBag.BotList)
                    {
                        <option value="@item.BotId" >@item.BotName</option>
                    }
                </select>
            </div>

            <div class="lbl-field width-40">Status</div>
            <div class="edit-field width-120">
                <select id="Status" class="select2-choice width-120">
                    <option value="">All</option>
                    @foreach (var item in ViewBag.StatusList)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
            
            <div class="lbl-field width-40">@Html.LabelFor(m => m.FromDate, "From")</div>
            <div class="edit-field width-130">
                @Html.TextBox("FromDate", Model.FromDate.ToString("MMM dd,yyyy"), "", new { style = "width: 100px" })
            </div>

            <div class="lbl-field width-40">@Html.LabelFor(m => m.ToDate, "To")</div>
            <div class="edit-field width-130">
                @Html.TextBox("ToDate", Model.ToDate.ToString("MMM dd,yyyy"), "", new { style = "width: 100px" })
            </div>

            <div class="submit">
                <input id="button-search" type="submit" value="Submit" />
            </div>
        </div>
    </div>
</section>
<section id="body">
    <div id="message-list-container" class="message-list-container">
        <div id="message-list" class="freegrid display-none"></div>
    </div>
    @Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
</section>
@section Foot {

    <script src="~/scripts/lib/contextmenu/contextmenucontroller.js" type="text/javascript"></script>
    <script src="~/scripts/lib/custom-datepicker.js" type="text/javascript"></script>
    <script src="~/scripts/lib/popup/dialogbox.js" type="text/javascript"></script>
    <script src="~/message/message.js" type="text/javascript"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~/")';
        var viewResources = {
            hasEditRight: @(hasHostManageMessage ? 1 : 0)
                };
    </script>
}