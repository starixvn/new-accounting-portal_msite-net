@model Maintenance.Sites.Controllers.ServiceViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fanex Data Service</title>

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <style>
        body {
            padding: 20px;
        }

        .card {
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .btn-loading {
            position: relative;
            pointer-events: none;
            opacity: 0.65;
        }

        .btn-loading::after {
            content: '';
            display: inline-block;
            width: 1rem;
            height: 1rem;
            margin-left: 0.5rem;
            vertical-align: text-bottom;
            border: 0.2em solid currentColor;
            border-right-color: transparent;
            border-radius: 50%;
            animation: spinner-border .75s linear infinite;
        }

        @@keyframes spinner-border {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="alert-info mb-0">                    
                    <h5 class="card-title">Server: @Model.Server, Uptime: @Model.UptimeMinutes/@Model.MaximumUptimeMinutes minutes</h5>                                        
                </div>
            </div>
            <div class="col-md-12">
                <div class="alert-info mb-0" id="service-status">                                        
                </div>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-md-6">
                @using (Html.BeginForm("Index", "FanexDataService", FormMethod.Post))
                {
                    <div class="d-flex align-items-center gap-3">
                        <label for="SelectedService" class="mb-0">Service:</label>
                        @Html.DropDownListFor(m => m.SelectedService,
                        Model.ServiceUrls.Select(url => new SelectListItem
                        {
                            Text = url,
                            Value = url,
                            Selected = url == Model.SelectedService
                        }),
                        new { @class = "form-control" })
                        <button type="submit" class="btn btn-primary">Statistic</button>
                        <button type="button" class="btn btn-warning" id="gcButton">Gc</button>
                        <button type="button" class="btn btn-danger" id="killButton">Kill</button>
                        <button type="button" class="btn btn-info" id="statusButton">Status</button>
                    </div>
                }
            </div>                   
        </div>      

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Requests Chart</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="requestsChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Responses Chart</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="responsesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">DB Statistics</h5>
                    </div>
                    <div class="card-body">
                        <table id="dbStatTable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Database</th>
                                    <th>Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.DbStatistic)
                                {
                                    <tr>
                                        <td>@item.Key</td>
                                        <td>@item.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">SP Statistics</h5>
                    </div>
                    <div class="card-body">
                        <table id="spStatTable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Stored Procedure</th>
                                    <th>Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SpStatistic)
                                {
                                    <tr>
                                        <td>@item.Key</td>
                                        <td>@item.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
                function setButtonLoading(button, isLoading) {
                    if (isLoading) {
                        button.addClass('btn-loading');
                        button.prop('disabled', true);
                    } else {
                        button.removeClass('btn-loading');
                        button.prop('disabled', false);
                    }
                }

                // Handle GC button click
                $('#gcButton').click(function() {
                    var selectedService = $('#SelectedService').val();
                    var $button = $(this);
                    if (selectedService) {
                        setButtonLoading($button, true);
                        $.get('/FanexDataService/Gc', { serviceUrl: selectedService })
                            .done(function(result) {
                                $('#service-status').text(result);
                            })
                            .fail(function(jqXHR, textStatus, errorThrown) {
                                $('#service-status').text('Error performing GC: ' + textStatus);
                            })
                            .always(function() {
                                setButtonLoading($button, false);
                            });
                    }
                });

                // Handle Kill button click
                $('#killButton').click(function() {
                    var selectedService = $('#SelectedService').val();
                    var $button = $(this);
                    if (selectedService) {
                        setButtonLoading($button, true);
                        $.get('/FanexDataService/Kill', { serviceUrl: selectedService })
                            .done(function(result) {
                                $('#service-status').text(result);
                            })
                            .fail(function(jqXHR, textStatus, errorThrown) {
                                $('#service-status').text('Error killing service: ' + textStatus);
                            })
                            .always(function() {
                                setButtonLoading($button, false);
                            });
                    }
                });

                // Handle Status button click
                $('#statusButton').click(function() {
                    var selectedService = $('#SelectedService').val();
                    var $button = $(this);
                    if (selectedService) {
                        setButtonLoading($button, true);
                        $.get('/FanexDataService/Status', { serviceUrl: selectedService })
                            .done(function(result) {
                                $('#service-status').text(result);
                            })
                            .fail(function(jqXHR, textStatus, errorThrown) {
                                $('#service-status').text('Error checking status: ' + textStatus);
                            })
                            .always(function() {
                                setButtonLoading($button, false);
                            });
                    }
                });

                // Initialize DataTables
                $('#dbStatTable').DataTable({
                    order: [[1, 'desc']], // Sort by count column descending
                    pageLength: 10
                });
                $('#spStatTable').DataTable({
                    order: [[1, 'desc']], // Sort by count column descending
                    pageLength: 10
                });

                // Setup Requests Chart
                const requestsCtx = document.getElementById('requestsChart').getContext('2d');
                new Chart(requestsCtx, {
                    type: 'line',
                    data: {
                        labels: Array.from({ length: @Model.Requests.Count }, (_, i) => {
                            return `${i}`;
                        }),
                        datasets: [{
                            data: @Html.Raw(Json.Serialize(Model.Requests)),
                            borderColor: 'rgb(75, 192, 192)',
                            backgroundColor: 'rgba(75, 192, 192, 0.1)',
                            fill: true,
                            tension: 0.1
                        }]
                    },
                     options: {
                         responsive: true,
                         plugins: {
                             legend: {
                                 display: false
                             },
                             title: {
                                 display: true,
                                 text: 'Request Rate Over Time',
                                 font: {
                                     size: 16
                                 }
                             },
                             tooltip: {
                                 callbacks: {
                                     title: function(context) {
                                         const xValue = context[0].dataIndex;
                                         const m = @Model.Requests.Count - xValue;
                                         const now = new Date();
                                         const timeValue = new Date(now - m * 60000); // Convert minutes to milliseconds
                                         return timeValue.toLocaleString('en-US', { 
                                            year: 'numeric',
                                            month: '2-digit',
                                            day: '2-digit',
                                            hour: '2-digit',
                                            minute: '2-digit',
                                            hour12: false
                                         });
                                     },
                                     label: function(context) {
                                         return `Requests: ${context.raw}`;
                                     }
                                 }
                             }
                         },
                        scales: {
                            x: {
                                title: {
                                    display: true,
                                    text: 'Time Since Service Start',
                                    font: {
                                        size: 14
                                    }
                                },
                                reverse: false,
                                grid: {
                                    display: false
                                }
                            },
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Requests per Minute',
                                    font: {
                                        size: 14
                                    }
                                },
                                ticks: {
                                    callback: function(value) {
                                        return value;
                                    }
                                }
                            }
                        }
                    }
                });

                // Setup Responses Chart
                const responsesCtx = document.getElementById('responsesChart').getContext('2d');
                new Chart(responsesCtx, {
                    type: 'line',
                    data: {
                        labels: Array.from({ length: @Model.Responses.Count }, (_, i) => {
                            return `${(i + 1)*1000}`;
                            }),
                        datasets: [{
                            data: @Html.Raw(Json.Serialize(Model.Responses)),
                            borderColor: 'rgb(153, 102, 255)',
                            tension: 0.1
                        }]
                    },
                    options: {
                        responsive: true,
                         plugins: {
                            legend: {
                                 display: false
                            },
                            title: {
                                display: true,
                                text: 'Response Rate Over Size',
                                font: {
                                    size: 16
                                }
                            }

                        },
                        scales: {
                            x: {
                                title: {
                                    display: true,
                                    text: 'Response Size',
                                    font: {
                                        size: 14
                                    }
                                },
                                reverse: false,
                                grid: {
                                    display: false
                                }
                            },
                            y: {
                                title: {
                                    display: true,
                                    text: 'Response count',
                                    font: {
                                        size: 14
                                    }
                                },
                                beginAtZero: true
                            }
                        }
                    }
                });
            });
    </script>
</body>
</html>
