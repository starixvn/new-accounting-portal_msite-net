@model Maintenance.Sites.Controllers.UmSportModel
@{
    ViewBag.Title = "Um Sports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
}
@section HeadLine
{
    <h1>
        <span class="title">@ViewBag.Title</span>
    </h1>
}

@using (Html.BeginForm("Execute", "UmSport"))
{
    <div class="form">
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.SportTypeIds)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.SportTypeIds, new { style = "width: 500px" })
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                <input type="submit" name="submitType" value="Set UM" style="margin-right: 10px" />
                <input type="submit" name="submitType" value="Remove UM" />
            </div>
        </div>
        <div class="form-row">
            @if (TempData["Error"] != null)
        {
                <div style="color: red;">
                @TempData["Error"]
        </div>
        } else {
                <div>
                    @TempData["Result"]
        </div>
            }
        </div>
    </div>
}