@model MailRecord
@{
    ViewBag.Title = Labels.Mail_Detail;
    Layout = null;
}
<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en" class="linen" ng-app="app">
<!--<![endif]-->
<head>
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="/css/common.css" type="text/css" />
    <link rel="stylesheet" href="/css/common-less.css" type="text/css" />
    <link href="~/themes/shared/formedit.less" rel="stylesheet" type="text/css" />
    <link href="~/mailstation/css/mailreportdetail.less?v=1" rel="stylesheet" type="text/css" />
</head>
<body id="body">
    <div class="form">
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    @Labels.From</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    @Model.MailFrom</label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    @Labels.To</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    @Model.MailTo</label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    @Labels.CC</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    @Model.MailCc
                </label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    @Labels.BCC</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    @Model.MailBcc
                </label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    @Labels.Mail_Date</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    @Model.MailDate</label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    @Labels.Title</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    @Model.Title
                </label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    @Labels.Subject</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    @Model.Subject</label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    @Labels.Body</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    @Html.Raw(Model.Body)</label>
            </div>
        </div>
    </div>
    <script type="text/ecmascript" src="/scripts/sharedscripts.js"></script>
    <script src="~/mailstation/maildetailcontroller.js" type="text/javascript" ></script>
</body>
</html>
